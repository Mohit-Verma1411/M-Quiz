<%- include('../partials/header', { title: 'Quiz Results' }) %>

  <div class="section" style="max-width:820px;margin:0 auto">
    <div class="section-head">
      <div>
        <h2>Results · <%= quiz.title %></h2>
        <p><span class="tag accent">#<%= quiz.quiz_code %></span> · <%= quiz.total_marks %> points</p>
      </div>
      <div class="flex">
        <a class="btn btn-ghost btn-sm" href="/admin/quiz/<%= quiz.id %>">Edit quiz</a>
        <a class="btn btn-gradient btn-sm" id="liveAnchor" href="#">🏆 Live board</a>
        <a class="btn btn-hot btn-sm" id="exportCsv" href="#">⬇ Export CSV</a>
        <button class="btn btn-success btn-sm" id="announceWinners">📣 Announce winners</button>
        <button class="btn btn-ghost btn-sm" id="toggleActive">—</button>
      </div>
    </div>

    <div class="table-wrap glass">
      <table>
        <thead>
          <tr><th>Rank</th><th>Participant</th><th>Email</th><th>Score</th><th>Time taken</th><th>Submitted</th><th style="text-align:right">Actions</th></tr>
        </thead>
        <tbody id="quizResults" data-quiz-id="<%= quiz.id %>">
          <tr><td colspan="7" class="center muted">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Remove attempt record modal -->
  <div id="removeAttemptModal" class="overlay" style="display:none">
    <div class="glass card" style="max-width:420px;width:100%;padding:28px">
      <div class="flex between">
        <h3>Remove attempt record</h3>
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('removeAttemptModal').style.display='none'">✕</button>
      </div>
      <p class="mt-2" id="removeAttemptText">Remove this attempt?</p>
      <p class="faint" style="font-size:.85rem">This deletes the attempt's score and answers. The participant (and their device) will be allowed to retake this quiz — they get one more chance.</p>
      <div class="form-error" data-remove-error style="margin:12px 0"></div>
      <div class="flex" style="justify-content:flex-end;gap:10px;margin-top:18px">
        <button class="btn btn-ghost" onclick="document.getElementById('removeAttemptModal').style.display='none'">Cancel</button>
        <button class="btn btn-danger" id="confirmRemoveAttempt">Remove record</button>
      </div>
    </div>
  </div>

<%- include('../partials/footer', { scripts: ['/js/admin.js'] }) %>